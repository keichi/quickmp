// vim: set ft=cpp:
#pragma _NEC options "-O4 -finline-functions -report-all"

#include <veda_device.h>

#include "ve/internal.hpp"
#include "stomp.hpp"

extern "C" {

void selfjoin_kernel(VEDAdeviceptr T_ptr, VEDAdeviceptr P_ptr, size_t n, size_t m, int normalize)
{
    const double *T = nullptr;
    double *P = nullptr;

    vedaMemPtr((void **)&T, T_ptr);
    vedaMemPtr((void **)&P, P_ptr);

    stomp::selfjoin(T, P, n, m, normalize);
}

void selfjoin_batch_kernel(VEDAdeviceptr T_ptr, VEDAdeviceptr P_ptr, size_t count, size_t n,
                           size_t m, int normalize)
{
    const double *T = nullptr;
    double *P = nullptr;

    vedaMemPtr((void **)&T, T_ptr);
    vedaMemPtr((void **)&P, P_ptr);

    stomp::selfjoin_batch(T, P, count, n, m, normalize);
}

void abjoin_kernel(VEDAdeviceptr T1_ptr, VEDAdeviceptr T2_ptr, VEDAdeviceptr P_ptr, size_t n1,
                   size_t n2, size_t m, int normalize)
{
    const double *T1 = nullptr;
    const double *T2 = nullptr;
    double *P = nullptr;

    vedaMemPtr((void **)&T1, T1_ptr);
    vedaMemPtr((void **)&T2, T2_ptr);
    vedaMemPtr((void **)&P, P_ptr);

    stomp::abjoin(T1, T2, P, n1, n2, m, normalize);
}

}
